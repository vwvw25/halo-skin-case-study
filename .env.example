# Copy to .env and fill in only what you need. Everything defaults to mock; the pipeline runs
# fully offline with no values set.

# Global default mode for every source: mock | live
META_REPORTING_MODE=mock

# --- Meta Marketing API (only needed when its source is live) ---
# META_SOURCE=live            # per-source override of META_REPORTING_MODE
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_XXXXXXXXXX
# META_API_VERSION=v21.0

# --- Shopify Admin API (only needed when its source is live) ---
# SHOPIFY_SOURCE=live
# SHOPIFY_STORE=halo-skin      # the <store>.myshopify.com subdomain
# SHOPIFY_ADMIN_TOKEN=

# --- Delivery (off unless set): local | drive | email ---
# DELIVER_CHANNEL=drive
# DRIVE_FOLDER_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_TO=
